{
  "name": "imagetrans-pro",
  "version": "1.0.0",
  "description": "ImageTrans Pro - Image text overlay desktop tool",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "vite build && electron .",
    "build": "vite build",
    "dist": "vite build && electron-builder",
    "vite:dev": "vite",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run --config vite.config.test.js",
    "test:watch": "vitest --config vite.config.test.js"
  },
  "dependencies": {
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.38",
    "prettier": "^3.9.0",
    "tailwindcss": "^3.4.4",
    "vite": "^5.3.0",
    "vitest": "^4.1.9"
  },
  "build": {
    "appId": "com.imagetrans.pro",
    "productName": "ImageTrans Pro",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.cjs",
      "package.json"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "language": "2052"
    }
  }
}
